{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.grok/hooks/scripts/session_tokens_boot.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.grok/hooks/scripts/session_handoff_boot.sh\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
