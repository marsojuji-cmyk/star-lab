# Copy to ~/.grok/lab/otel.env and fill in YOUR collector (never commit secrets).
# source ~/.grok/lab/otel.env before launching grok

export OTEL_EXPORTER_OTLP_ENDPOINT="https://your-collector.example:4318"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
# export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer REPLACE_ME"

# Optional: only metrics / only traces
# export OTEL_METRICS_EXPORTER=otlp
# export OTEL_TRACES_EXPORTER=otlp
# export OTEL_LOGS_EXPORTER=none
