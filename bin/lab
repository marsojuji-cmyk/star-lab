#!/usr/bin/env bash
# Grok Star Lab — unified CLI facade (main integration)
set -euo pipefail

# Resolve monorepo root from this script's real path (follows ~/.local/bin/lab symlink).
_lab_src="${BASH_SOURCE[0]}"
while [[ -L "$_lab_src" ]]; do
  _lab_dir="$(cd "$(dirname "$_lab_src")" && pwd)"
  _lab_link="$(readlink "$_lab_src")"
  if [[ "$_lab_link" != /* ]]; then
    _lab_src="${_lab_dir}/${_lab_link}"
  else
    _lab_src="$_lab_link"
  fi
done
_LAB_BIN="$(cd "$(dirname "$_lab_src")" && pwd)"
ROOT="$(cd "${_LAB_BIN}/.." && pwd)"
export ROOT
export GROK_LAB_REPO="${GROK_LAB_REPO:-$ROOT}"
unset _lab_src _lab_dir _lab_link

# shellcheck disable=SC1091
if [[ -f "${ROOT}/lib/common.sh" ]]; then
  # shellcheck source=../lib/common.sh
  source "${ROOT}/lib/common.sh"
else
  [[ -x "${HOME}/homebrew/bin/brew" ]] && eval "$("${HOME}/homebrew/bin/brew" shellenv)" 2>/dev/null || true
  export PATH="${HOME}/.grok/bin:${HOME}/.local/bin:${HOME}/homebrew/bin:/usr/local/bin:${PATH}"
fi

_py() {
  local rel="$1"
  shift
  local path="${ROOT}/${rel}"
  if [[ ! -f "$path" ]]; then
    echo "error: missing ${path}" >&2
    exit 1
  fi
  exec python3 "$path" "$@"
}

usage() {
  cat << EOF
Grok Star Lab  (lab)

  lab help                 this usage
  lab doctor [args…]       full health check (exec bin/doctor)
  lab status               one-screen vitals (exec bin/status)
  lab install [args…]      create ~/.grok/lab, symlink, packaging, token hooks
  lab dash                 snapshot + open Mission Control (file://)
  lab observatory …        snapshot | dash | report
  lab forge …              experiment tracking
  lab gym …                model gym (smoke|eval|list) — offline dolphin3
  lab tokens …             token-aware control plane (route|audit|distill)
  lab knowledge …          FTS knowledge index/query
  lab arena …              offline script pipelines / workflow handoff
  lab design …             Design Studio register/list
  lab ship …               Ship Bay checks + capture
  lab showroom …           capture | list | publish | open
  lab imagine …            offline asset verify
  lab sandbox …            lab sandbox profiles
  lab dock …               integration dock / MCP fallbacks
  lab sqc …                SQC annotation quality (risk|sample|loop|asn)
  lab research …           golden log + packets + LEAD recover + KPIs
  lab graph …              token-constrained context routing (L2 / RCR-style)
  lab weights …            safetensors interchange (validate|convert|publish-check)

Data root: ~/.grok/lab
Repo:      ${ROOT}
Token policy: lab tokens policy  (auto-armed on SessionStart)
Annotation quality: lab sqc loop  (Loop 3 gate before distill)
Research log: lab research start|packet|recover|complete|kpi
Graph context: lab graph route-context|log-node|stats|ablate
Weights:      lab weights layout|validate|convert  (publish safetensors only)
EOF
}

cmd="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  help|-h|--help)
    usage
    exit 0
    ;;
  doctor)
    exec "${_LAB_BIN}/doctor" "$@"
    ;;
  status)
    exec "${_LAB_BIN}/status" "$@"
    ;;
  install)
    install_sh="${ROOT}/scripts/install-lab.sh"
    if [[ ! -f "$install_sh" ]]; then
      echo "error: missing ${install_sh}" >&2
      exit 1
    fi
    exec bash "$install_sh" "$@"
    ;;
  dash|dashboard)
    _py modules/observatory/cli.py dash "$@"
    ;;
  observatory)
    _py modules/observatory/cli.py "$@"
    ;;
  forge)
    _py modules/forge/cli.py "$@"
    ;;
  gym)
    _py modules/gym/cli.py "$@"
    ;;
  tokens|token)
    _py modules/tokens/cli.py "$@"
    ;;
  knowledge)
    _py modules/knowledge/cli.py "$@"
    ;;
  arena)
    _py modules/arena/cli.py "$@"
    ;;
  design)
    _py modules/design/cli.py "$@"
    ;;
  ship)
    _py modules/ship/cli.py "$@"
    ;;
  showroom)
    _py modules/showroom/cli.py "$@"
    ;;
  imagine)
    _py modules/imagine/cli.py "$@"
    ;;
  sandbox)
    _py modules/sandbox/cli.py "$@"
    ;;
  dock)
    _py modules/dock/cli.py "$@"
    ;;
  sqc|quality)
    _py modules/sqc/cli.py "$@"
    ;;
  research)
    _py modules/research/cli.py "$@"
    ;;
  graph)
    _py modules/graph/cli.py "$@"
    ;;
  weights|weight)
    _py modules/weights/cli.py "$@"
    ;;
  *)
    echo "error: unknown command: ${cmd}" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
